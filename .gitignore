# ---- Build output ----
/build/
/out/
CMakeUserPresets.json
compile_commands.json
.cache/

# ---- Editors and IDEs (the shared VS Code files are kept) ----
.vs/
*.user
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# ---- Claude Code personal files and worktrees ----
CLAUDE.local.md
.claude/settings.local.json
.claude/worktrees/

# ---- Secrets: API keys (e.g. for AI services), private keys, signing certificates ----
# These never belong in git. Keep a variable-names-only template as .env.example.
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
*.p8
id_rsa*
id_ed25519*
secrets.json
credentials*.json
service-account*.json
# Crash dumps hold the app's whole memory, including any key it has loaded.
*.dmp

# ---- OS clutter ----
Thumbs.db
Desktop.ini
.DS_Store

# ---- From GitHub's C++ template ----
# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
