# Normalise line endings in the repository (LF) and check out with each platform's default.
* text=auto

# Windows batch files must keep CRLF; shell scripts must keep LF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.sh  text eol=lf
# Git hooks are shell scripts without an extension (git runs them with sh, on Windows too).
.githooks/* text eol=lf

# Fonts, sounds and other binary data: never convert line endings.
*.ttf binary
*.flac binary
*.ogg binary
*.wav binary
