{
  "name": "Phazite",
  "description": "Shortcuts that most music apps and the operating system share. \"command\" is Ctrl on Windows and Linux, Cmd on macOS.",
  "keys": {
    "transport.playStop": [ "spacebar" ],
    "transport.goToStart": [ "home" ],
    "transport.goToEnd": [ "end" ],
    "edit.undo": [ "command + Z" ],
    "edit.redo": [ "command + shift + Z", "command + Y" ],
    "edit.delete": [ "delete", "backspace" ],
    "edit.duplicate": [ "command + D" ],
    "edit.rename": [ "command + R", "F2" ],
    "edit.selectAll": [ "command + A" ],
    "edit.split": [ "command + E" ],
    "edit.insertTime": [ "command + I" ],
    "edit.removeTime": [ "command + shift + delete" ],
    "edit.mute": [ "0" ],
    "edit.nudgeLeft": [ "cursor left" ],
    "edit.nudgeRight": [ "cursor right" ],
    "edit.quantize": [ "command + U" ],
    "note.transposeUp": [ "cursor up" ],
    "note.transposeDown": [ "cursor down" ],
    "note.octaveUp": [ "shift + cursor up" ],
    "note.octaveDown": [ "shift + cursor down" ],
    "note.lengthen": [ "shift + cursor right" ],
    "note.shorten": [ "shift + cursor left" ],
    "note.legato": [ "command + L" ],
    "note.chop": [ "command + E" ],
    "note.selectAll": [ "command + A" ],
    "note.quantizeSettings": [ "command + shift + U" ],
    "note.applyTransform": [ "return" ],
    "note.cancelTransform": [ "escape" ],
    "tool.smart": [ "escape", "1" ],
    "tool.draw": [ "P", "2" ],
    "tool.paint": [ "B", "3" ],
    "tool.slice": [ "C", "4" ],
    "tool.slip": [ "S", "5" ],
    "tool.mute": [ "T", "6" ],
    "tool.delete": [ "D", "7" ],
    "tool.select": [ "E", "8" ],
    "tool.zoom": [ "Z", "9" ],
    "track.add": [ "command + T" ],
    "track.groupIntoFolder": [ "command + G" ],
    "track.ungroup": [ "command + shift + G" ],
    "track.collapse": [ "U" ],
    "track.selectPrevious": [ "cursor up" ],
    "track.selectNext": [ "cursor down" ],
    "track.taller": [ "alt + =" ],
    "track.shorter": [ "alt + -" ],
    "project.new": [ "command + N" ],
    "project.open": [ "command + O" ],
    "project.save": [ "command + S" ],
    "project.saveAs": [ "command + shift + S" ],
    "view.commandPalette": [ "command + K" ],
    "view.pianoRoll": [ "F7" ],
    "view.toggleBrowser": [ "F8" ],
    "view.mixer": [ "F9" ],
    "view.zoomIn": [ "=", "numpad +" ],
    "view.zoomOut": [ "-", "numpad -" ],
    "view.followPlayback": [ "command + shift + F" ],
    "grid.finer": [ "command + 1" ],
    "grid.coarser": [ "command + 2" ],
    "grid.triplets": [ "command + 3" ],
    "grid.snap": [ "command + 4" ],
    "grid.adaptive": [ "command + 5" ],
    "input.computerKeyboard": [ "M" ],
    "options.settings": [ "command + ," ],
    "view.interfaceLarger": [ "command + =", "command + numpad +" ],
    "view.interfaceSmaller": [ "command + -", "command + numpad -" ],
    "view.interfaceNormal": [ "command + 0", "command + numpad 0" ]
  }
}
