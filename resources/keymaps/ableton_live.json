{
  "name": "Ableton Live",
  "description": "Ableton Live 12's shortcuts, from its manual, for the commands Phazite has. F9 records, Ctrl+L loops the selected time, 0 mutes the selected clips and R reverses them, S solos and C arms the selected tracks, Ctrl+Alt+M shows the mixer and Ctrl+Alt+3 the piano roll. B is the Draw tool and E, held, the Slice tool, as Live splits notes; Esc goes back to the Smart Tool, and 1 to 9 pick the tools, as in Phazite's keymap. Shift+? turns hover help on and off, as Live's Info View. Capture has no key, as in Live.",
  "keys": {
    "transport.playStop": [ "spacebar" ],
    "transport.playPause": [ "shift + spacebar" ],
    "transport.goToStart": [ "home" ],
    "transport.goToEnd": [ "end" ],
    "transport.record": [ "F9" ],
    "transport.loopSelection": [ "command + L" ],
    "transport.metronome": [ "O" ],
    "edit.undo": [ "command + Z" ],
    "edit.redo": [ "command + Y", "command + shift + Z" ],
    "edit.cut": [ "command + X" ],
    "edit.copy": [ "command + C" ],
    "edit.paste": [ "command + V" ],
    "edit.delete": [ "delete", "backspace" ],
    "edit.duplicate": [ "command + D" ],
    "edit.rename": [ "command + R" ],
    "edit.selectAll": [ "command + A" ],
    "edit.split": [ "command + E" ],
    "edit.insertTime": [ "command + I" ],
    "edit.removeTime": [ "command + shift + delete" ],
    "edit.mute": [ "0" ],
    "edit.nudgeLeft": [ "cursor left" ],
    "edit.nudgeRight": [ "cursor right" ],
    "edit.quantize": [ "command + U" ],
    "clip.reverse": [ "R" ],
    "clip.previousTake": [ "command + cursor up" ],
    "clip.nextTake": [ "command + cursor down" ],
    "note.transposeUp": [ "cursor up" ],
    "note.transposeDown": [ "cursor down" ],
    "note.octaveUp": [ "shift + cursor up" ],
    "note.octaveDown": [ "shift + cursor down" ],
    "note.lengthen": [ "shift + cursor right" ],
    "note.shorten": [ "shift + cursor left" ],
    "note.chop": [ "command + E" ],
    "note.selectAll": [ "command + A" ],
    "note.quantizeSettings": [ "command + shift + U" ],
    "note.applyTransform": [ "return", "command + return" ],
    "note.cancelTransform": [ "escape" ],
    "automation.showLanes": [ "A" ],
    "automation.raisePoints": [ "cursor up" ],
    "automation.lowerPoints": [ "cursor down" ],
    "automation.raisePointsMore": [ "shift + cursor up" ],
    "automation.lowerPointsMore": [ "shift + cursor down" ],
    "tool.smart": [ "escape", "1" ],
    "tool.draw": [ "B", "2" ],
    "tool.paint": [ "3" ],
    "tool.slice": [ "E", "4" ],
    "tool.slip": [ "5" ],
    "tool.mute": [ "6" ],
    "tool.delete": [ "7" ],
    "tool.select": [ "8" ],
    "tool.zoom": [ "9" ],
    "track.add": [ "command + T" ],
    "track.addReturn": [ "command + alt + T" ],
    "track.groupIntoFolder": [ "command + G" ],
    "track.ungroup": [ "command + shift + G" ],
    "device.group": [ "command + G" ],
    "device.ungroup": [ "command + shift + G" ],
    "track.collapse": [ "U" ],
    "track.solo": [ "S" ],
    "track.arm": [ "C" ],
    "track.freeze": [ "command + alt + shift + F" ],
    "track.bounceInPlace": [ "command + B" ],
    "track.selectPrevious": [ "cursor up" ],
    "track.selectNext": [ "cursor down" ],
    "track.taller": [ "alt + =" ],
    "track.shorter": [ "alt + -" ],
    "project.new": [ "command + N" ],
    "project.open": [ "command + O" ],
    "project.save": [ "command + S" ],
    "project.saveAs": [ "command + shift + S" ],
    "project.export": [ "command + shift + R" ],
    "view.commandPalette": [ "command + K" ],
    "view.menus": [ "F10" ],
    "view.mixer": [ "command + alt + M" ],
    "view.pianoRoll": [ "command + alt + 3" ],
    "view.instrument": [ "command + alt + 4" ],
    "view.toggleBrowser": [ "command + alt + B" ],
    "view.toggleEditor": [ "command + alt + L" ],
    "view.toggleInspector": [ "command + alt + I" ],
    "view.hoverHelp": [ "shift + /" ],
    "view.maximizePanel": [ "shift + F11" ],
    "view.fullScreen": [ "F11" ],
    "view.searchBrowser": [ "command + F" ],
    "device.add": [ "F8" ],
    "view.zoomIn": [ "=", "numpad +" ],
    "view.zoomOut": [ "-", "numpad -" ],
    "view.zoomToFit": [ "W" ],
    "view.followPlayback": [ "command + shift + F" ],
    "grid.finer": [ "command + 1" ],
    "grid.coarser": [ "command + 2" ],
    "grid.triplets": [ "command + 3" ],
    "grid.snap": [ "command + 4" ],
    "grid.adaptive": [ "command + 5" ],
    "input.computerKeyboard": [ "M" ],
    "options.settings": [ "command + ," ],
    "view.interfaceLarger": [ "command + =", "command + numpad +" ],
    "view.interfaceSmaller": [ "command + -", "command + numpad -" ],
    "view.interfaceNormal": [ "command + 0", "command + numpad 0" ]
  }
}
