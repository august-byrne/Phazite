{
  "name": "FL Studio",
  "description": "FL Studio's shortcuts, from its manual, for the commands Phazite has so far. Ctrl+Z undoes or redoes the last change; Ctrl+Alt+Z undoes step by step. Ctrl+T turns the computer keyboard's notes on or off, and F10 opens the MIDI settings. In the playlist, right-click deletes clips.",
  "rightClickDeletes": true,
  "keys": {
    "transport.playStop": [ "spacebar" ],
    "transport.goToStart": [ "home" ],
    "edit.undoOrRedo": [ "command + Z" ],
    "edit.undo": [ "command + alt + Z" ],
    "edit.delete": [ "delete" ],
    "edit.duplicate": [ "command + B" ],
    "edit.rename": [ "F2" ],
    "edit.selectAll": [ "command + A" ],
    "edit.deselectAll": [ "command + D" ],
    "clip.mute": [ "alt + M" ],
    "clip.nudgeLeft": [ "shift + cursor left" ],
    "clip.nudgeRight": [ "shift + cursor right" ],
    "tool.smart": [ "escape" ],
    "tool.draw": [ "P" ],
    "tool.paint": [ "B" ],
    "tool.slice": [ "C" ],
    "tool.slip": [ "S" ],
    "tool.mute": [ "T" ],
    "tool.delete": [ "D" ],
    "tool.select": [ "E" ],
    "tool.zoom": [ "Z" ],
    "track.selectPrevious": [ "command + cursor up" ],
    "track.selectNext": [ "command + cursor down" ],
    "project.open": [ "command + O" ],
    "project.save": [ "command + S" ],
    "project.saveAs": [ "command + shift + S" ],
    "view.commandPalette": [ "command + K" ],
    "view.pianoRoll": [ "F7" ],
    "view.toggleBrowser": [ "alt + F8" ],
    "view.mixer": [ "F9" ],
    "view.zoomIn": [ "page up" ],
    "view.zoomOut": [ "page down" ],
    "view.zoomToFit": [ "shift + 4" ],
    "view.centreOnPlayhead": [ "shift + 0" ],
    "grid.snap": [ "backspace" ],
    "options.midiSettings": [ "F10" ],
    "input.computerKeyboard": [ "command + T" ]
  }
}
