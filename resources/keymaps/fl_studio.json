{
  "name": "FL Studio",
  "description": "FL Studio's shortcuts, from its manual, for the commands Phazite has so far. Ctrl+Z undoes or redoes the last change; Ctrl+Alt+Z undoes step by step. Ctrl+T turns the computer keyboard's notes on or off, and F10 opens the MIDI settings. In the playlist, a click on empty space places the last clip used, right-click deletes clips, and Ctrl+drag selects a time range, which loops while it is selected. Capture, which FL Studio doesn't have, is Ctrl+Shift+C, as in Phazite's keymap.",
  "rightClickDeletes": true,
  "clickPlacesClips": true,
  "selectionLoops": true,
  "keys": {
    "transport.playStop": [ "spacebar" ],
    "transport.playPause": [ "command + spacebar" ],
    "transport.goToStart": [ "home" ],
    "transport.record": [ "R" ],
    "transport.capture": [ "command + shift + C" ],
    "transport.loopSelection": [ "command + L" ],
    "transport.metronome": [ "command + M" ],
    "transport.countIn": [ "command + P" ],
    "edit.undoOrRedo": [ "command + Z" ],
    "edit.undo": [ "command + alt + Z" ],
    "edit.delete": [ "delete" ],
    "edit.duplicate": [ "command + B" ],
    "edit.rename": [ "F2" ],
    "edit.selectAll": [ "command + A" ],
    "edit.deselectAll": [ "command + D" ],
    "edit.mute": [ "alt + M" ],
    "edit.nudgeLeft": [ "shift + cursor left" ],
    "edit.nudgeRight": [ "shift + cursor right" ],
    "edit.quantize": [ "command + alt + Q" ],
    "note.transposeUp": [ "shift + cursor up" ],
    "note.transposeDown": [ "shift + cursor down" ],
    "note.octaveUp": [ "command + cursor up" ],
    "note.octaveDown": [ "command + cursor down" ],
    "note.legato": [ "command + L" ],
    "note.chop": [ "command + U" ],
    "note.chopSettings": [ "alt + U" ],
    "note.selectAll": [ "command + A" ],
    "note.quantizeSettings": [ "alt + Q" ],
    "note.applyTransform": [ "return" ],
    "note.cancelTransform": [ "escape" ],
    "tool.smart": [ "escape" ],
    "tool.draw": [ "P" ],
    "tool.paint": [ "B" ],
    "tool.slice": [ "C" ],
    "tool.slip": [ "S" ],
    "tool.mute": [ "T" ],
    "tool.delete": [ "D" ],
    "tool.select": [ "E" ],
    "tool.zoom": [ "Z" ],
    "track.selectPrevious": [ "command + cursor up" ],
    "track.selectNext": [ "command + cursor down" ],
    "project.open": [ "command + O" ],
    "project.save": [ "command + S" ],
    "project.saveAs": [ "command + shift + S" ],
    "project.export": [ "command + R" ],
    "view.commandPalette": [ "command + K" ],
    "view.pianoRoll": [ "F7" ],
    "view.toggleBrowser": [ "alt + F8" ],
    "device.add": [ "F8" ],
    "view.mixer": [ "F9" ],
    "view.zoomIn": [ "page up" ],
    "view.zoomOut": [ "page down" ],
    "view.zoomToFit": [ "shift + 4" ],
    "view.centreOnPlayhead": [ "shift + 0" ],
    "grid.snap": [ "backspace" ],
    "options.midiSettings": [ "F10" ],
    "input.computerKeyboard": [ "command + T" ]
  }
}
