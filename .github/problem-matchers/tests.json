{
  "problemMatcher": [
    {
      "owner": "doctest-linux",
      "pattern": [
        {
          "regexp": "^(.+?):(\\d+): (?:FATAL )?ERROR: (.*)$",
          "file": 1,
          "line": 2,
          "message": 3
        }
      ]
    },
    {
      "owner": "doctest-windows",
      "pattern": [
        {
          "regexp": "^(.+?)\\((\\d+)\\): (?:FATAL )?ERROR: (.*)$",
          "file": 1,
          "line": 2,
          "message": 3
        }
      ]
    },
    {
      "owner": "doctest-values",
      "severity": "warning",
      "pattern": [
        {
          "regexp": "^\\s+((?:values|logged): .+)$",
          "message": 1
        }
      ]
    },
    {
      "owner": "sanitizers",
      "pattern": [
        {
          "regexp": "^SUMMARY: ((?:Address|Thread|UndefinedBehavior|Leak)Sanitizer: .*)$",
          "message": 1
        }
      ]
    },
    {
      "owner": "sanitizer-frames",
      "severity": "warning",
      "pattern": [
        {
          "regexp": "^\\s+#(\\d+) 0x[0-9a-f]+ in (.+) /home/runner/work/Phazite/Phazite/((?:src|tests|external)/[^:]+):(\\d+)(?::\\d+)?$",
          "code": 1,
          "message": 2,
          "file": 3,
          "line": 4
        }
      ]
    },
    {
      "owner": "tsan-frames",
      "severity": "warning",
      "pattern": [
        {
          "regexp": "^\\s+#([0-5]) (.+) /home/runner/work/Phazite/Phazite/((?:src|tests|external)/[^:]+):(\\d+)(?::\\d+)? \\([^)]*\\)$",
          "code": 1,
          "message": 2,
          "file": 3,
          "line": 4
        }
      ]
    }
  ]
}
